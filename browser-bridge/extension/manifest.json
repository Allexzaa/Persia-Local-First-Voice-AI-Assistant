{
  "manifest_version": 3,
  "name": "Persia Browser Bridge",
  "version": "1.0",
  "description": "Connects Persia AI agent to your browser",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Persia Bridge"
  },

  "web_accessible_resources": [
    {
      "resources": ["extractors/linkedin.js"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
